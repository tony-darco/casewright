# casewright — optional configuration.
#
# You do NOT need this file to run the app in development: every setting below has a
# working default, and everything a user can change lives in Settings (Model provider,
# Knowledge base, Meraki integration) rather than here.
#
# What's left is bootstrap config only — things the app must know *before* it can read
# its own database, or deployment posture that must not be user-settable.

# --- required in production ----------------------------------------------------------
# In dev (CASEWRIGHT_DEV=1) both are generated once and persisted to ~/.config/casewright/
# with 0600 perms, so you don't need to set them locally. Production must supply them
# explicitly: the app deliberately won't invent its own, both so they can come from a real
# secret store, and because a container generating its own JWT secret would log every user
# out each time it was recreated.
#
# Signs session cookies. Must be verifiable before we know which user is calling, so it
# can't live in the per-user settings table.
JWT_SECRET=
# Fernet key encrypting stored secrets (the Meraki API key) at rest. Can't be stored
# inside the thing it encrypts.
CASEWRIGHT_ENC_KEY=

# --- development ---------------------------------------------------------------------
# Skip the production secret check and run on generated dev-only defaults. Never set
# this in production.
CASEWRIGHT_DEV=1

# --- deployment posture (optional; sane defaults) -------------------------------------
# Where the SQLite database file lives. Point this at a mounted volume in Docker.
# CASEWRIGHT_DB_PATH=/data/casewright.db
# Send session cookies only over HTTPS. Enable in production.
# COOKIE_SECURE=1
# Session lifetime in seconds (default: 7 days).
# TOKEN_TTL_SECONDS=604800
# Meraki API base URL (default: https://api.meraki.com/api/v1).
# MERAKI_BASE_URL=

# --- model / vector store (all overridable per-user in Settings) -----------------------
# These only change the *defaults* a user's Settings start from. Prefer Settings.
# AUTOTEST_PROVIDER=ollama
# AUTOTEST_OLLAMA_URL=http://localhost:11434
# AUTOTEST_CHAT_MODEL=
# AUTOTEST_EMBED_MODEL=
# AUTOTEST_CHAT_REASONING=
# Local Chroma directory (default: data/chroma, inside the app). Settings → Knowledge
# base can instead point at a remote Chroma server.
# AUTOTEST_DATA_DIR=
# AUTOTEST_CHROMA_URL=

# --- CLI spec ingest only (python -m rag.ingest.split) ---------------------------------
# Not used by the running app — the Knowledge base Settings page replaces these.
# AUTOTEST_SPECS_DIR=data/specs
# AUTOTEST_SPECS_OUT_DIR=data/specs/path_docs
# AUTOTEST_SPEC_SOURCE=local
