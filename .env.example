# casewright — secrets and deployment posture.
#
# Configuration lives in two files at the repo root, and the app reads and writes both:
#
#   config.yaml   every non-secret setting — model provider, knowledge-base storage,
#                 run-container images and limits. Written with the defaults on first
#                 run, and safe to hand-edit; Settings saves back to this exact file.
#   .env          this file: secrets, plus the few deployment knobs below.
#
# Copy this to .env and fill in what you need. Everything here is optional for local
# development — the app runs on defaults with no .env at all.
#
# Keep .env at 0600 (the app sets that itself whenever it writes a secret) and never
# commit it — it's gitignored, and holds your API key in plaintext.

# --- secrets --------------------------------------------------------------------------
# Meraki Dashboard API key. Settings → Meraki writes it here; set it by hand instead if
# you'd rather. A real exported environment variable takes precedence over this file,
# so a container or CI secret store can inject it without one.
MERAKI_API_KEY=

# --- deployment posture (optional; sane defaults) --------------------------------------
# Where the SQLite database file lives — tests, runs, knowledge-base versions, and the
# cached Meraki org tree. Settings are NOT in here. Point this at a mounted volume in
# Docker.
# CASEWRIGHT_DB_PATH=/data/casewright.db
# Meraki API base URL (default: https://api.meraki.com/api/v1).
# MERAKI_BASE_URL=

# --- model / vector store --------------------------------------------------------------
# The *floor* under config.yaml: these set the defaults a blank config.yaml field falls
# back to. Prefer config.yaml (or Settings) — these exist so the CLI tools below and the
# eval harness can run without one.
# AUTOTEST_PROVIDER=ollama
# AUTOTEST_OLLAMA_URL=http://localhost:11434
# AUTOTEST_CHAT_MODEL=
# AUTOTEST_EMBED_MODEL=
# AUTOTEST_CHAT_REASONING=
# Local Chroma directory (default: data/chroma, inside the app). config.yaml's
# knowledge_base section can instead point the store at a remote Chroma server.
# AUTOTEST_DATA_DIR=
# AUTOTEST_CHROMA_URL=

# --- CLI spec ingest only (python -m rag.ingest.split) ----------------------------------
# Not used by the running app — the Knowledge base screen replaces these.
# AUTOTEST_SPECS_DIR=data/specs
# AUTOTEST_SPECS_OUT_DIR=data/specs/path_docs
# AUTOTEST_SPEC_SOURCE=local
