/* casewright TUI — Claude Code layout: banner, transcript, prompt. */

Screen {
    background: $background;
}

/* Launch banner: logo/wordmark + context, hairline divider below. */
#banner {
    height: auto;
    padding: 1 2 1 2;
    border-bottom: solid $panel-darken-1;
}

/* The transcript fills the body. */
#transcript {
    height: 1fr;
    padding: 1 2;
    background: transparent;
    scrollbar-size-vertical: 1;
}

.eyebrow {
    color: $text-muted;
    text-style: bold;
}

/* --- knowledge base: boxed panels, dense rows, colour as the only decoration --- */
#kb-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#kb-versions {
    height: 1fr;
    border: round $panel-lighten-1;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
    background: transparent;
    scrollbar-size-vertical: 1;
}

#kb-versions > .datatable--header {
    color: $text-muted;
    text-style: bold;
    background: transparent;
}

#kb-versions > .datatable--cursor {
    background: $panel-lighten-1;
}

#kb-storage {
    height: 3;
    border: round $panel-lighten-1;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
    margin-top: 1;
}

#kb-status {
    height: auto;
    padding: 1 1 0 1;
    color: $text-muted;
}

/* --- command bar (Claude Code prompt) --------------------------------------- */
CommandBar {
    height: auto;
    padding: 0 1 0 1;
}

#command-suggest {
    display: none;
    height: auto;
    max-height: 14;   /* _MENU_ROWS + the two 'N more' markers + border */
    margin: 0 1 0 1;
    padding: 0 2;
    background: $surface;
    border: round $panel-darken-1;
}

#command-row {
    height: 3;
    border: round $panel-lighten-1;
    background: $surface;
}

#command-prompt {
    width: 3;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

#command {
    border: none;
    height: 100%;
    padding: 0;
    background: transparent;
}

#command-hint {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

/* Where you are, directly above the input. */
#command-place {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    text-style: bold;
}

/* --- /edit: a modal text area over the workspace ----------------------------- */
EditorScreen {
    align: center middle;
    background: $background 92%;
}

#editor-box {
    width: 88%;
    height: 82%;
}

#editor-area {
    height: 1fr;
    border: round $panel-lighten-1;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
    scrollbar-size-vertical: 1;
}

#editor-hint {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}
