/* casewright TUI — Claude Code layout: banner, transcript, prompt. */

Screen {
    background: $background;
}

/* Launch banner: logo/wordmark + context, hairline divider below. */
#banner {
    height: auto;
    padding: 1 2 1 2;
    border-bottom: solid $panel-darken-1;
}

/* The transcript fills the body. */
#transcript {
    height: 1fr;
    padding: 1 2;
    background: transparent;
    scrollbar-size-vertical: 1;
}

.eyebrow {
    color: $text-muted;
    text-style: bold;
}

/* --- command bar (Claude Code prompt) --------------------------------------- */
CommandBar {
    height: auto;
    padding: 0 1 0 1;
}

#command-row {
    height: 3;
    border: round $panel-lighten-1;
    background: $surface;
}

#command-prompt {
    width: 3;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

#command {
    border: none;
    height: 100%;
    padding: 0;
    background: transparent;
}

#command-hint {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}
